@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="fcard shadow-lg">

    <!-- Header -->
    <div class="text-center mb-4">
        <span class="slbl">Welcome Back</span>
        <h2 class="stitle" style="font-size: 2rem;">Sign <span>In</span></h2>
        <div class="sline"></div>
        <p class="sdesc">Sign in to access your account</p>
    </div>

    <!-- Feedback Messages -->
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-info text-center" role="alert" style="font-size: 0.85rem;">
            @ViewBag.Message
        </div>
    }
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger text-center" role="alert" style="font-size: 0.85rem;">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- Login Form -->
    <form asp-action="Login" method="post">

        <div class="mb-3">
            <label for="username" class="flbl">Username</label>
            <input type="text" class="fctrl" id="username" name="username" placeholder="user, admin, or provider" required autocomplete="username" />
        </div>

        <div class="mb-4">
            <label for="password" class="flbl">Password</label>
            <input type="password" class="fctrl" id="password" name="password" placeholder="••••••••" />
            <div class="form-text text-muted" style="font-size: 0.75rem;">Password is optional for the prototype.</div>
        </div>

        <div class="d-grid mb-3">
            <button type="submit" class="btn-red justify-content-center py-3">Sign In</button>
        </div>

        <!-- Prototype Hint Box -->
        <div class="p-3 mb-3 rounded" style="background: var(--light); border: 1px dashed #ddd; font-size: 0.78rem; color: #666;">
            <strong>Prototype Hint:</strong><br />
            • Type <code>user</code> to link to Home.<br />
            • Type <code>admin</code> or <code>provider</code> for placeholders.
        </div>

        <!-- Footer Links -->
        <div class="text-center mt-3">
            <p style="font-size: 0.85rem; color: #777;">
                Don't have an account? <a href="@Url.Action("Register", "Account")" style="color: var(--primary); font-weight: 600;">Register here</a>
            </p>
        </div>
    </form>

</div>