@{
    ViewData["Title"] = "Home Page";
}

<!-- ============================================================
     FIX 1 – SEARCH OVERLAY POPUP
     ============================================================ -->
<div id="searchOv">
    <button class="sovclose" id="searchClose"><i class="fas fa-times"></i></button>
    <div class="sovbox">
        <h4>What are you craving today boss?</h4>
        <div class="sovinput">
            <input type="text" id="searchInput" placeholder="Search drinks..." autocomplete="off" />
            <button><i class="fas fa-search"></i></button>
        </div>
    </div>
</div>
<!-- ============================================================
     HERO
     ============================================================ -->
<section id="hero">
    <div class="hs hs1"></div>
    <div class="hs hs2"></div>
    <div class="hbgtxt">FOOD</div>
    <div class="container">
        <div class="row align-items-center g-5" style="min-height:88vh;">
            <div class="col-lg-6">
                <div class="hbadge">
                    <div class="hbi"><i class="fas fa-star"></i></div>
                    <span>#1 Rated beer slingers in Mažeikiai</span>
                </div>
                <h1 class="htitle">Fast <span class="hl">Cheap</span><br />Delicious</h1>
                <p class="hdesc">Drinks from all over the world right at your doorstep</p>
                <div class="d-flex flex-wrap gap-3 mb-2">
                    <a href="#menu" class="btn-red"><i class="fas fa-utensils"></i>Explore Menu</a>
                </div>
                <div class="hstats d-flex gap-3 flex-wrap mt-4">
                    <div class="hstat"><span class="snum">3mil<em>+</em></span><small>Happy Customers</small></div>
                    <div class="sdiv"></div>
                    <div class="hstat"><span class="snum">150<em>+</em></span><small>Expert breweries and distilleries</small></div>
                    <div class="sdiv"></div>
                    <div class="hstat"><span class="snum">837<em>yr</em></span><small>Experience</small></div>
                </div>
            </div>
            <div class="col-lg-6">
                <div style="position:relative;text-align:center;">
                    <div class="hcircle">
                        <img src="~/img/banner-img.jpg" alt="Burger" />
                    </div>
                    <div class="fcard fc1">
                        <div class="fcoi r"><i class="fas fa-fire"></i></div>
                        <div><span class="fcnum">Hot Deal</span><span class="fcsm">0% off today</span></div>
                    </div>
                    <div class="fcard fc2">
                        <div class="fcoi y"><i class="fas fa-star"></i></div>
                        <div><span class="fcnum">4.9/5</span><span class="fcsm">2k+ reviews</span></div>
                    </div>
                    <div class="fcard fc3">
                        <div class="fcoi g"><i class="fas fa-clock"></i></div>
                        <div><span class="fcnum">2 day</span><span class="fcsm">Fast delivery</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- CATEGORY -->
<section id="category">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <span class="slbl">Curated Collection</span>
            <h2 class="stitle">Browse by <span>Category</span></h2>
            <div class="sline"></div>
            <p class="sdesc mx-auto" style="max-width:480px;">From crisp local ciders to aged reserve spirits - discover your perfect pour</p>
        </div>
        <div class="row g-3 justify-content-center">
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="0">
                <div class="catcard active" data-filter="all">
                    <img class="catimg" src="~/img/category/all.jpg" alt="All Drinks" />
                    <div class="catnm">All Bottles</div>
                    <div class="catct">120 items</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="70">
                <div class="catcard" data-filter="wine">
                    <img class="catimg" src="~/img/category/wine.jpg" alt="Wine" />
                    <div class="catnm">Wine</div>
                    <div class="catct">45 items</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="140">
                <div class="catcard" data-filter="beer">
                    <img class="catimg" src="~/img/category/beer.jpg" alt="Beer" />
                    <div class="catnm">Beer</div>
                    <div class="catct">35 items</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="210">
                <div class="catcard" data-filter="ciders">
                    <img class="catimg" src="~/img/category/cider.jpg" alt="Ciders" />
                    <div class="catnm">Ciders</div>
                    <div class="catct">18 items</div>
                </div>
            </div>
            <div class="col-6 col-sm-4 col-md-3 col-lg-2" data-aos="zoom-in" data-aos-delay="280">
                <div class="catcard" data-filter="spirits">
                    <img class="catimg" src="~/img/category/spirits.jpg" alt="Spirits" />
                    <div class="catnm">Spirits</div>
                    <div class="catct">22 items</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     OFFER MENU / PRODUCT CATALOGUE
     ============================================================ -->
<section id="menu">
    <div class="container">
        <div class="text-center mb-5" data-aos="fade-up">
            <h2 class="stitle">Our Bottle <span>Catalog</span></h2>
            <div class="sline"></div>
        </div>
        <!-- Filter buttons -->
        <div class="text-center mb-4" data-aos="fade-up">
            <button class="filtbtn active" data-f="all">All</button>
            <button class="filtbtn" data-f="wine">Wine</button>
            <button class="filtbtn" data-f="beer">Beer</button>
            <button class="filtbtn" data-f="ciders">Ciders</button>
            <button class="filtbtn" data-f="spirits">Spirits</button>
        </div>
        <div class="row g-4" id="mgrid">
            <!-- CARD 1: Wine -->
            <div class="col-sm-6 col-lg-4 mwrap" data-c="wine" data-aos="fade-up">
                <div class="mcard"
                     data-img="~/img/menu/wine1.jpg"
                     data-title="Reserve Cabernet Sauvignon"
                     data-cat="Wine"
                     data-price="$24.99" data-old="$32.99"
                     data-rating="4.9" data-reviews="128"
                     data-cal="13.5% ABV" data-time="750ml"
                     data-desc="Rich full-bodied red wine with deep notes of blackberry, cassis, and a hint of French oak finish. Perfect paired with artisan cheeses and grilled steak."
                     data-tags="Red Wine,Reserve,Dry">
                    <div class="mimg">
                        <img src="~/img/menu/wine1.jpg" alt="Cabernet Sauvignon" />
                        <div class="mbdg hot"><i class="fas fa-star"></i> Featured</div>
                        <div class="mhrt"><i class="far fa-heart"></i></div>
                    </div>
                    <div class="mbody">
                        <div class="mcat">Wine</div>
                        <div class="mtit">Reserve Cabernet Sauvignon</div>
                        <div class="mdesc">Rich red with notes of blackberry, cassis, and French oak finish</div>
                        <div class="mfoot">
                            <div>
                                <div class="mprice">$24.99 <small>$32.99</small></div>
                                <div class="mstars"><i class="fas fa-star"></i> <span style="color:#bbb;font-size:.7rem;">(128)</span></div>
