<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alkobaronas</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />

    <!-- Main Template Style CSS -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Alkobaronas.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
</head>
<body style="background-color: #121212; color: #fff; font-family: 'Poppins', sans-serif; display: flex; flex-direction: column; min-height: 100vh;">

    <!-- Auth Header -->
    <header style="background-color: #181818; border-bottom: 1px solid #282828; padding: 15px 0;">
        <div class="container">
            <a class="navbar-brand text-decoration-none" href="@Url.Action("Index", "Home")">
                <div class="blogo d-flex align-items-center gap-2">
                    <div class="bico" style="width: 40px; height: 40px; overflow: hidden; border-radius: 50%;">
                        <img src="~/img/banner-img.jpg" alt="Logo" style="width: 100%; height: 100%; object-fit: cover;" />
                    </div>
                    <div>
                        <div class="bname" style="font-family: 'Playfair Display', serif; font-size: 1.25rem; font-weight: 700; color: #fff; line-height: 1.1;">
                            Alko<span style="color: #ffc107;">baronas</span>
                        </div>
                        <div class="bsub" style="font-size: 0.65rem; color: #888; text-transform: uppercase; letter-spacing: 1px;">
                            Fast Food & Restaurant
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-grow-1 d-flex align-items-center justify-content-center py-5">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Auth Footer -->
    <footer style="background-color: #181818; border-top: 1px solid #282828; padding: 20px 0; text-align: center; font-size: 0.85rem; color: #aaa;">
        <div class="container">
            <p class="mb-1">&copy; 2026 Alkobaronas. All rights reserved.</p>
            <p class="mb-0">
                Need help? Contact support at
                <a href="mailto:support@alkobaronas-prototype.com" style="color: #ffc107; text-decoration: none;">support@alkobaronas-prototype.com</a>
            </p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>