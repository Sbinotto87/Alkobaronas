<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Alkobaronas</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Poppins:wght@300;400;500;600;700&family=Dancing+Script:wght@700&display=swap" rel="stylesheet" />

    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/all.min.css" />

    <!-- Main Template Style CSS -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Alkobaronas.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/png" href="~/images/favicon.png" />
</head>
<body style="background-color: var(--light); min-height: 100vh; display: flex; flex-direction: column; margin: 0; overflow-x: hidden;">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg" id="nav" style="width: 100%;">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <div class="blogo">
                    <div class="bico">
                        <img src="~/img/banner-img.jpg" alt="Logo" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />
                    </div>
                    <div>
                        <div class="bname">Alko<span>baronas</span></div>
                        <div class="bsub">From the street to the bloodstream</div>
                    </div>
                </div>
            </a>
            <div class="d-flex align-items-center gap-2">
                <a href="@Url.Action("Login", "Account")" class="nav-link" style="font-weight: 600; color: var(--dark) !important;">Sign In</a>
                <a href="@Url.Action("Register", "Account")" class="nav-cta"><i class="fas fa-user-plus me-1"></i>Register</a>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT CONTAINER (Strictly Centered) -->
    <main role="main" style="flex: 1; width: 100%; display: flex; align-items: flex-start; justify-content: center; padding: 80px 15px;">
        <div style="width: 100%; display: flex; justify-content: center;">
            @RenderBody()
        </div>
    </main>


    <!-- FOOTER -->
    <footer style="width: 100%;">
        <div class="container pb-4">
            <div class="row g-5">
                <div class="col-lg-6">
                    <div class="fnm">Alko<span>baronas</span></div>
                    <p class="fdesc">Drinks from all over the world right at your doorstep.</p>
                </div>
                <div class="col-lg-6 text-lg-end">
                    <div class="ftit">Support & Contact</div>
                    <ul class="flinks ps-0" style="list-style:none;">
                        <li><a href="mailto:support@alkobaronas-prototype.com"><i class="fas fa-envelope text-primary me-2"></i>support@alkobaronas-prototype.com</a></li>
                        <li><span style="color:#777; font-size:0.86rem;"><i class="fas fa-phone-alt text-primary me-2"></i>+370 600 00000</span></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="fbot">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <p>&copy; 2026 Alkobaronas. All rights reserved.</p>
                    <p>Prototype Build <span>v1.0</span></p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>